EXPO_PUBLIC_API_HOST=192.168.0.0

# 네이티브 소셜(Google/카카오 SDK) — Expo Go·웹 개발: false / APK 테스트: true
EXPO_PUBLIC_NATIVE_SOCIAL=false
# 웹 브라우저 OAuth — 기본 true, 끄려면 false
EXPO_PUBLIC_WEB_SOCIAL=true

# Google OAuth (Google Cloud Console)
# Expo Go 개발: Web application 클라이언트 ID 필수
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 선택: 네이티브 빌드용
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Kakao Developers → 앱 → 앱 키
# REST API 키: 웹 OAuth + 백엔드 code 교환
EXPO_PUBLIC_KAKAO_REST_API_KEY=
# 네이티브 앱 키: Android/iOS SDK (APK·expo run:android)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
